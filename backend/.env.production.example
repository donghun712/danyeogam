DATABASE_URL=jdbc:mysql://db-host:3306/danyeogam?useUnicode=true&characterEncoding=UTF-8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DATABASE_USERNAME=danyeogam_app
DATABASE_PASSWORD=replace-with-database-password
DATABASE_POOL_MAX_SIZE=10
DATABASE_POOL_MIN_IDLE=2

SERVER_PORT=8080
SERVER_COMPRESSION_ENABLED=true
SERVER_COMPRESSION_MIN_RESPONSE_SIZE=2KB

TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_SERVICE_KEY=replace-with-data-go-kr-service-key
TOUR_API_MOBILE_OS=ETC
TOUR_API_MOBILE_APP=다녀감
TOUR_API_CONNECT_TIMEOUT=3s
TOUR_API_READ_TIMEOUT=10s

