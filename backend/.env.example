MYSQL_PORT=3306
MYSQL_DATABASE=danyeogam
MYSQL_USER=danyeogam
MYSQL_PASSWORD=danyeogam-local
MYSQL_ROOT_PASSWORD=danyeogam-root-local
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
SERVER_COMPRESSION_ENABLED=true
SERVER_COMPRESSION_MIN_RESPONSE_SIZE=2KB
SERVER_MAX_HTTP_REQUEST_HEADER_SIZE=16KB
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_SERVICE_KEY=replace-with-data-go-kr-service-key
TOUR_API_MOBILE_OS=ETC
TOUR_API_MOBILE_APP=다녀감
TOUR_API_CONNECT_TIMEOUT=3s
TOUR_API_READ_TIMEOUT=10s
KAKAO_REST_API_KEY=replace-with-kakao-rest-api-key
KAKAO_LOCAL_BASE_URL=https://dapi.kakao.com
KAKAO_CONNECT_TIMEOUT=3s
KAKAO_READ_TIMEOUT=5s
TOUR_SYNC_ENABLED=false
TOUR_SYNC_AREA_CODE=1
TOUR_SYNC_PAGE_SIZE=50
TOUR_SYNC_MAX_PAGES=1
TOUR_SYNC_HYDRATE_DETAILS=true
MAP_QUERY_MAX_LATITUDE_SPAN=1.0
MAP_QUERY_MAX_LONGITUDE_SPAN=1.0
MAP_QUERY_MAX_RESULTS=1000
GEO_REVERSE_CACHE_TTL=5m
GEO_REVERSE_CACHE_MAX_ENTRIES=10000
PARKING_DEFAULT_RADIUS_METERS=3000
PARKING_MAX_RADIUS_METERS=20000
PARKING_DEFAULT_LIMIT=3
PARKING_MAX_LIMIT=15
PARKING_CACHE_TTL=5m
PARKING_CACHE_MAX_ENTRIES=5000
SESSION_COOKIE_NAME=dg_session
SESSION_COOKIE_PATH=/api
SESSION_TTL=90d
SESSION_TOUCH_INTERVAL=1h
SESSION_COOKIE_SECURE=false
STAMP_DEFAULT_RADIUS_METERS=100
STAMP_MAX_ACCURACY_METERS=50
STAMP_MAX_LOCATION_AGE=2m
STAMP_MAX_FUTURE_SKEW=10s
STAMP_MAX_ATTEMPTS_PER_MINUTE=5
CORS_ALLOWED_ORIGINS=http://localhost:5173
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS_PER_MINUTE=600
API_RATE_LIMIT_SESSION_CREATES_PER_MINUTE=20
API_RATE_LIMIT_MAX_TRACKED_CLIENTS=10000
